# Copy to .env and fill in. .env is ignored by git.
PORT=8081
MONGODB_URI=mongodb://localhost/sistema-faculdade
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# SMTP for the "forgot password" email (Mailtrap works for testing)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.com
